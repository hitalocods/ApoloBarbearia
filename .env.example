# ============================================================
# APOLO BARBEARIA — VARIÁVEIS DE AMBIENTE (ENV)
# ============================================================

# 1. NEON POSTGRESQL (String de conexão obtida no console da Neon)
# Exemplo: postgresql://neondb_owner:SENHA@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@seu-host-neon.tech/neondb?sslmode=require"

# 2. VERCEL BLOB (Token de leitura/escrita do Blob Storage da Vercel)
# Gerado automaticamente quando você cria o Blob no painel da Vercel
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. SENHA DO PAINEL ADMINISTRATIVO (Opcional - padrão: apolo123)
ADMIN_PASSWORD="apolo123"

# 4. WEB PUSH NOTIFICATIONS (VAPID)
VAPID_PUBLIC_KEY="sua_chave_publica_vapid"
VAPID_PRIVATE_KEY="sua_chave_privada_vapid"
VAPID_SUBJECT="mailto:contato@apolobarbearia.com.br"
